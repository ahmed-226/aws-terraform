# Terraform state files - CRITICAL
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform directories
.terraform/
.terraform.lock.hcl

# Sensitive variable files - but NOT example files
terraform.tfvars
backend.tfvars
*.tfvars.json
terraform.tfvars.json

# SSH keys and credentials
*.pem
*.key
*.ppk

# OS files
.DS_Store
Thumbs.db

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json